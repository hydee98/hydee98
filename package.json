{
  "name": "crypto-ai-rwa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-to-peer marketplace (property + general items) with USDC escrow: Solana/Anchor program + Claude-powered listing screening/pricing/chat/dispute backend + React dApp frontend",
  "workspaces": [
    "app/backend",
    "app/frontend"
  ],
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "dev:backend": "npm run dev --workspace app/backend",
    "dev:frontend": "npm run dev --workspace app/frontend",
    "build:backend": "npm run build --workspace app/backend",
    "build:frontend": "npm run build --workspace app/frontend"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.3",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.7",
    "chai": "^4.4.1",
    "mocha": "^10.7.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0"
  }
}
