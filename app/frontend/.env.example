# Leave unset for local dev - Vite proxies /api to http://localhost:8787 (see vite.config.ts)
VITE_API_BASE_URL=

VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_MARKETPLACE_PROGRAM_ID=Byjh8A9Zir4PXUPUDJufmC6xoii5LN9W2omdt5D9LUuw

# USDC (or a compatible test mint) - the only currency escrowed on-chain.
# Must match the usdc_mint passed to initialize_marketplace.
VITE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Wallet that receives the 2% platform fee on completed sales (buyback/
# reward distribution). The default below is a placeholder keypair
# generated for this repo - its private key was discarded - replace it
# with your real treasury address before going live.
VITE_TREASURY_WALLET=FiCbFyfCHLCia1odL53qjTFGuPyNYMgppVRmXZC6aNod
