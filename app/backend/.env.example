# Required for the AI endpoints (fraud screening, price suggestion, chat, dispute summaries).
# Get a key at https://console.anthropic.com/ - never commit a real key.
ANTHROPIC_API_KEY=

# Required for arbitrator/authority actions (resolve a dispute, get its AI
# summary, apply a fraud score to a listing) - a shared secret the arbitrator
# enters once in the frontend's Disputes page. Generate any long random
# string, e.g. `openssl rand -hex 32`. Leave unset in local dev if you don't
# need to exercise those actions; they'll return 503 until it's set.
ADMIN_TOKEN=

# Signing secret for wallet sign-in sessions (JWTs). Generate any long
# random string, e.g. `openssl rand -hex 32`. Leave unset in local dev if
# you don't need to sign in; auth routes return 503 until it's set.
JWT_SECRET=

# Postgres connection string - when set, listings/orders persist in the
# database (schema is created automatically on boot) and survive restarts.
# Leave unset to use an in-memory store that resets every restart (fine for
# quick local dev, not for anything you want to stick around).
# Local Postgres example: postgresql://user:password@localhost:5432/marketai?sslmode=disable
DATABASE_URL=

# Optional overrides
ANTHROPIC_MODEL=claude-opus-5
PORT=8787

# Comma-separated list of allowed frontend origins in production, e.g.
# https://marketai-frontend.onrender.com - leave unset to allow all origins
# (fine for local dev, not recommended once this is live).
CORS_ORIGIN=

# Solana cluster used for on-chain reads (see src/services/solanaService.ts)
SOLANA_RPC_URL=https://api.devnet.solana.com
MARKETPLACE_PROGRAM_ID=Byjh8A9Zir4PXUPUDJufmC6xoii5LN9W2omdt5D9LUuw

# Platform fee in basis points (200 = 2%) taken from the seller's payout
# only when an order actually completes - never on a refund/cancellation -
# and routed to TREASURY_WALLET for buyback/reward distribution to the
# platform token's holders. Must match the `fee_bps` passed to the
# on-chain program's initialize_marketplace/set_fee_config; this value
# only drives the informational fee shown in the UI (see
# src/services/pricingService.ts) - the real deduction happens on-chain.
PLATFORM_FEE_BPS=200

# The following two are on-chain deployment-time parameters, not runtime
# server config - the Express server never signs Solana transactions.
# They're documented here so they live next to MARKETPLACE_PROGRAM_ID; set
# them when you run `initialize_marketplace` (see README "Deploying the
# on-chain program"), and set the frontend's matching VITE_USDC_MINT /
# VITE_TREASURY_WALLET to the same values.
#
# USDC (or a compatible test mint) - the only currency this deployment
# ever escrows on-chain.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Wallet that receives the platform fee on completed sales.
TREASURY_WALLET=
