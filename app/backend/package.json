{
  "name": "rwa-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API: asset registry + Claude-powered valuation, risk scoring, due diligence and Q&A for the RWA tokenization platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@solana/web3.js": "^1.95.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
